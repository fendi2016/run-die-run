{
  "private": true,
  "name": "cursed",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run check:production && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test:types": "tsc --build",
    "test:unit": "node --experimental-strip-types --experimental-test-module-mocks --no-warnings=ExperimentalWarning --import ./tools/test-loader.mjs --test \"src/**/*.test.ts\"",
    "check:production": "npm run test:types && npm run lint && npm run test:unit && npm run build && node tools/check-client-build.mjs",
    "test:browser": "node tools/game-regressions.mjs",
    "type-check": "npm run test:types"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/start": "0.14.4",
    "@devvit/web": "0.14.4",
    "@gamotions/phaser-runtime-editor": "^0.1.2",
    "@hono/node-server": "2.1.1",
    "@phaser-game-engines/toolkit": "^0.2.0",
    "command-history": "^1.0.0",
    "devvit": "0.14.4",
    "hono": "4.13.7",
    "nanoid": "^6.0.1",
    "phaser": "4.2.1",
    "phaser4-rex-plugins": "^4.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@devvit/test": "^0.14.4",
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "^5.0.1"
  }
}
