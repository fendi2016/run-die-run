{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "sketchy-game",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a game post",
        "description": "Post the game hub (play, build, browse)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Post Level of the Day now",
        "description": "Feature the top trending level in a new post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/daily-level"
      },
      {
        "label": "Game stats",
        "description": "Players, retention, funnel and load times for the last 7 days",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/analytics"
      },
      {
        "label": "Reseed built-in levels (dev)",
        "description": "Sync every built-in level with seedLevels.ts",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reseed-levels"
      },
      {
        "label": "Reset built-in level stats (dev)",
        "description": "Zero the built-in levels' attempt/clear counts (keeps sabotage)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset-builtin-stats"
      },
      {
        "label": "Remove traps near spawn",
        "description": "Remove every player trap in the first 10 columns of every level (placed before that rule); players get the slot back",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/remove-start-traps"
      },
      {
        "label": "Undo last sabotage",
        "description": "Remove the newest trap from this post's level (press again to undo the one before)",
        "location": "post",
        "postFilter": "currentApp",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/undo-sabotage"
      },
      {
        "label": "Remove a player trap",
        "description": "Pick one player-added trap on this post's level and remove it",
        "location": "post",
        "postFilter": "currentApp",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/remove-trap"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "permissions": {
    "realtime": true,
    "reddit": {
      "asUser": [
        "SUBSCRIBE_TO_SUBREDDIT",
        "SUBMIT_COMMENT",
        "SUBMIT_POST"
      ]
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "sketchy_game_dev"
  },
  "scheduler": {
    "tasks": {
      "daily-level": {
        "endpoint": "/internal/scheduler/daily-level",
        "cron": "0 16 * * *"
      },
      "expire-traps": {
        "endpoint": "/internal/scheduler/expire-traps",
        "cron": "20 * * * *"
      }
    }
  },
  "forms": {
    "analyticsReport": "/internal/form/analytics-report",
    "removeTrap": "/internal/form/remove-trap"
  }
}
