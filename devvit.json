{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "cursed-game",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create a CURSED post",
        "description": "Post the CURSED hub (play, build, browse)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "CURSED: reseed built-in levels (dev)",
        "description": "Sync meat-grinder with seedLevels.ts",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reseed-levels"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "permissions": {
    "realtime": true,
    "reddit": {
      "asUser": [
        "SUBSCRIBE_TO_SUBREDDIT"
      ]
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "cursed_game_dev"
  }
}
